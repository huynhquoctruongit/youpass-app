# API Base URL (Go API - giống NEXT_PUBLIC_API bên homepage)
EXPO_PUBLIC_API=https://api.youpass.vn

# ============================================
# Google OAuth Client IDs
# QUAN TRỌNG: 3 Client ID này phải là 3 ID KHÁC NHAU,
# tạo trong Google Cloud Console -> Credentials -> Create OAuth Client ID
# ============================================

# Web Client ID (type "Web application") - dùng làm fallback cho web/Expo Go
# Có thể dùng chung ID với homepage Next.js
EXPO_PUBLIC_GOOGLE_CLIENT_ID=837990229170-dm0hv6ogn1ito47ecsp83tp9du8713el.apps.googleusercontent.com

# iOS Client ID (type "iOS") - Bundle ID: vn.youpass.app
# CHƯA TẠO - cần tạo riêng OAuth client type "iOS" trong Google Cloud Console
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=571466620528-n3crcu0o3np83or1n47k26t7427kg63l.apps.googleusercontent.com

# Android Client ID (type "Android") - Package: vn.youpass.app, SHA-1: F5:8F:50:29:C0:F2:35:23:C1:6B:1E:5E:48:16:0D:37:27:C5...
